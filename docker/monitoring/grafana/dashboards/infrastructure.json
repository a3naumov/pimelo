        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(redis_keyspace_hits_total[5m])",
          "legendFormat": "Hits",
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(redis_keyspace_misses_total[5m])",
          "legendFormat": "Misses",
          "range": true
