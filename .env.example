# Docker Configuration
COMPOSE_PROJECT_NAME=pimelo
COMPOSE_FILE=compose.yaml:compose.backend.yaml:compose.frontend.yaml:compose.media-storage.yaml:compose.notifications.yaml:compose.search.yaml:compose.dev.yaml
# Leave empty to select groups with --profile; use * to enable all groups.
COMPOSE_PROFILES=

# Caddy Configuration
SERVICE_CADDY_PORT=80

# Backend Configuration
SERVICE_BACKEND_PORT=8080
SERVICE_BACKEND_XDEBUG_SERVER_NAME=pimelo

# Notifications Configuration
SERVICE_NOTIFICATIONS_PORT=8081
SERVICE_NOTIFICATIONS_XDEBUG_SERVER_NAME=pimelo-notifications

# Media Storage Configuration
SERVICE_MEDIA_STORAGE_PORT=8082
SERVICE_MEDIA_STORAGE_XDEBUG_SERVER_NAME=pimelo-media-storage

# Search Configuration
SERVICE_SEARCH_PORT=8083
SERVICE_SEARCH_XDEBUG_SERVER_NAME=pimelo-search

# Frontend Configuration
SERVICE_FRONTEND_PORT=5173

# Postgres Configuration
SERVICE_POSTGRES_USER=dbuser
SERVICE_POSTGRES_PASSWORD=dbpassword
SERVICE_POSTGRES_DB=appdb
SERVICE_POSTGRES_PORT=5432

# Kafka Configuration
SERVICE_KAFKA_PORT=9092

# Redis Configuration
SERVICE_REDIS_PORT=6379

# OpenSearch Configuration
SERVICE_OPENSEARCH_PORT=9200
SERVICE_OPENSEARCH_DASHBOARDS_PORT=5601
SERVICE_OPENSEARCH_USERNAME=admin
