# Docker Configuration
COMPOSE_PROJECT_NAME=pimelo
COMPOSE_FILE=compose.yaml:compose.pim.yaml:compose.frontend.yaml:compose.media-storage.yaml:compose.notifications.yaml:compose.search.yaml:compose.dev.yaml
# Leave empty to select groups with --profile; use * to enable all groups.
COMPOSE_PROFILES=

# Caddy Configuration
SERVICE_CADDY_PORT=80

# PIM Configuration
SERVICE_PIM_XDEBUG_SERVER_NAME=pimelo

# Notifications Configuration
SERVICE_NOTIFICATIONS_XDEBUG_SERVER_NAME=pimelo-notifications

# Media Storage Configuration
SERVICE_MEDIA_STORAGE_XDEBUG_SERVER_NAME=pimelo-media-storage

# Search Configuration
SERVICE_SEARCH_XDEBUG_SERVER_NAME=pimelo-search

# Gateway Configuration
SERVICE_GATEWAY_XDEBUG_SERVER_NAME=pimelo-gateway

# Frontend Configuration
SERVICE_FRONTEND_PORT=5173

# Postgres Configuration
SERVICE_POSTGRES_USER=dbuser
SERVICE_POSTGRES_PASSWORD=dbpassword
SERVICE_POSTGRES_DB=appdb
SERVICE_POSTGRES_PORT=5432

# Kafka Configuration
SERVICE_KAFKA_PORT=9092

# Redis Configuration
SERVICE_REDIS_PORT=6379

# OpenSearch Configuration
SERVICE_OPENSEARCH_PORT=9200
SERVICE_OPENSEARCH_DASHBOARDS_PORT=5601
SERVICE_OPENSEARCH_USERNAME=admin
SERVICE_OPENSEARCH_ADMIN_PASSWORD=u9!Q2v@M7r^L4x!K8p

# Centrifugo Configuration
SERVICE_CENTRIFUGO_PORT=8000
SERVICE_CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=J7v!Q3m@R8x^K2p!L6w
SERVICE_CENTRIFUGO_API_KEY=P4n!T9y@C2k^W7r!M5q
SERVICE_CENTRIFUGO_ALLOWED_ORIGINS=http://localhost:5173

# MinIO Configuration
SERVICE_MINIO_PORT=9000
SERVICE_MINIO_CONSOLE_PORT=9001

# Monitoring is started explicitly with make monitoring, not make dev/prod.
# Set both passwords locally before make monitoring-init; never commit real secrets.
SERVICE_MONITORING_GRAFANA_PORT=3000
SERVICE_MONITORING_GRAFANA_ADMIN_USER=admin
SERVICE_MONITORING_GRAFANA_ADMIN_PASSWORD=
SERVICE_MONITORING_POSTGRES_PASSWORD=
SERVICE_MONITORING_METRICS_RETENTION=15d
SERVICE_MONITORING_METRICS_MAX_SIZE=5GB
SERVICE_MONITORING_LOG_RETENTION=168h
SERVICE_MONITORING_DOCKER_SOCKET=/var/run/docker.sock
SERVICE_MINIO_ROOT_USER=minio
SERVICE_MINIO_ROOT_PASSWORD=u9!Q2v@M7r^L4x!K8p
